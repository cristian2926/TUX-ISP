{
  "expo": {
    "name": "Tuxtell",
    "slug": "tuxtell-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tuxtell.isp",
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tuxtell.isp"
    },
    "scheme": "tuxtell",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
