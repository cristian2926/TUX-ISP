{
  "expo": {
    "name": "Tuxtell",
    "slug": "tuxtell-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E293B"
    },
    "android": {
      "package": "com.tuxtell.isp",
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E293B"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tuxtell.isp"
    },
    "scheme": "tuxtell",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0aedacf7-f1df-4468-a9ef-e85144348c19"
      }
    }
  }
}
